#!/usr/bin/env python3
"""sparsesom-paper1 reproduction CLI.

Usage:
    repro init                        Create experiment folder, download data
    repro all     [--run FOLDER]      Run all experiments (1-3, 5-8)
    repro gate    [--run FOLDER]      Prerequisites: corpus manifest, bringup, PCA (1-3)
    repro sweep   [--run FOLDER]      Size sweep (5)
    repro bench   [--run FOLDER]      Capacity frontier (7)
    repro compare [--run FOLDER]      Impl comparison + efficiency sweep (6, 8)
    repro run ID  [--run FOLDER]      Run a single experiment by ID
    repro figures [--run FOLDER]      Generate figures
    repro verify  [--run FOLDER]      Verify manuscript claims
    repro --smoke                     Quick ~10-min smoke test

Experiment folders live under experiments/ and are named SBS-ddmmyy-hhmm.
If --run is omitted, the most recent folder is used.  If no folder exists,
one is created automatically (data downloaded from Zenodo).
"""

import argparse
import re
import sys
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from pipeline.config import resolve
from pipeline.provenance import build_provenance, save_provenance
from pipeline.experiments import (
    ex01_corpus_manifest,
    ex02_bringup_gate,
    ex03_pca_equivalence,
    ex05_size_sweep,
    ex06_impl_compare,
    ex07_capacity_frontier,
    ex08_efficiency_sweep,
    ex09_sigma0_pca,
    ex10_roofline,
    ex11_somoclu,
)


EXPERIMENTS = {
    1: ("corpus_manifest", ex01_corpus_manifest),
    2: ("bringup_gate", ex02_bringup_gate),
    3: ("pca_equivalence", ex03_pca_equivalence),
    5: ("size_sweep", ex05_size_sweep),
    6: ("impl_compare", ex06_impl_compare),
    7: ("capacity_frontier", ex07_capacity_frontier),
    8: ("efficiency_sweep", ex08_efficiency_sweep),
    9: ("sigma0_pca", ex09_sigma0_pca),
    10: ("roofline", ex10_roofline),
    11: ("somoclu", ex11_somoclu),
}

# Sections partition the full set: gate ∪ sweep ∪ bench ∪ compare == all,
# each experiment in exactly one section. `repro --profile full` runs `all`.
SECTIONS = {
    "all":     [1, 2, 3, 5, 6, 7, 8, 9, 10, 11],
    "gate":    [1, 2, 3],
    "sweep":   [5, 9],
    "bench":   [7],
    "compare": [6, 8, 10, 11],
}

EXPERIMENTS_DIR = Path("experiments")
FOLDER_RE = re.compile(r"^SBS-\d{6}-\d{4}$")


def make_folder_name() -> str:
    return datetime.now().strftime("SBS-%d%m%y-%H%M")


def find_latest_folder() -> Path | None:
    if not EXPERIMENTS_DIR.exists():
        return None
    folders = sorted(
        [d for d in EXPERIMENTS_DIR.iterdir()
         if d.is_dir() and FOLDER_RE.match(d.name)],
        reverse=True,
    )
    return folders[0] if folders else None


def resolve_folder(run_arg: str | None, create_if_missing: bool = True) -> Path:
    """Resolve which experiment folder to use.

    If run_arg is given, look it up directly.  Otherwise use the most recent
    SBS-* folder.  When create_if_missing is True and nothing exists, run
    init automatically.
    """
    if run_arg:
        folder = EXPERIMENTS_DIR / run_arg
        if not folder.exists():
            print(f"ERROR: Experiment folder not found: {folder}")
            sys.exit(1)
        return folder

    latest = find_latest_folder()
    if latest:
        print(f"Using experiment folder: {latest.name}")
        return latest

    if create_if_missing:
        return do_init()

    print("ERROR: No experiment folders found. Run 'repro init' first.")
    sys.exit(1)


def do_init() -> Path:
    """Create a new timestamped experiment folder and download/prepare data."""
    from pipeline.fetch_data import fetch_and_prepare

    EXPERIMENTS_DIR.mkdir(exist_ok=True)
    name = make_folder_name()
    folder = EXPERIMENTS_DIR / name
    data_dir = folder / "data"
    results_dir = folder / "results"

    folder.mkdir()
    data_dir.mkdir()
    results_dir.mkdir()

    print(f"\n{'='*60}")
    print(f"INIT: {name}")
    print(f"{'='*60}")
    print(f"  data:    {data_dir}")
    print(f"  results: {results_dir}")
    print()

    fetch_and_prepare(data_dir)

    print(f"\nExperiment folder ready: {name}")
    return folder


def estimate_budget() -> str:
    return ("Estimated budget (single RTX 4090, 24 GB; measured on a clean-clone run):\n"
            "  gate    (1-3):     ~1 h      manifest + bringup + PCA equivalence\n"
            "  bench   (7):       minutes   capacity frontier\n"
            "  sweep   (5,9):     ~1 day    size sweep + sigma0 x PCA (5 seeds)\n"
            "  compare (6,8,10,11): ~5 days impl compare to convergence, efficiency\n"
            "                               sweep incl. MedSOM (~18 h), roofline (~1 h,\n"
            "                               needs ncu), somoclu CPU anchor (~23 h at 256^2)\n"
            "  ─────────────────────────────────────\n"
            "  all:               ~6.5 days complete reproduction")


def run_experiment(exp_id: int, data_dir: str, results_dir: str,
                   edges=None, seeds=None):
    if exp_id not in EXPERIMENTS:
        print(f"ERROR: Unknown experiment ID {exp_id}. "
              f"Valid: {sorted(EXPERIMENTS.keys())}")
        sys.exit(1)

    name, module = EXPERIMENTS[exp_id]

    print(f"\n{'='*60}")
    print(f"RUN {exp_id}: {name}")
    if edges:
        print(f"  (edge override: {edges})")
    if seeds:
        print(f"  (seed override: {seeds})")
    print(f"{'='*60}\n")

    t0 = time.monotonic()

    try:
        cfg = resolve(name)
    except FileNotFoundError:
        cfg = {}
    prov = build_provenance(cfg.get("config_hash", "none"))

    module.run(data_dir=data_dir, results_dir=results_dir,
               edges=edges, seeds=seeds)

    elapsed = time.monotonic() - t0
    print(f"\n  Completed in {elapsed:.1f}s")

    prov["wall_s"] = elapsed
    prov_path = Path(results_dir) / "provenance" / f"{name}.json"
    save_provenance(prov, prov_path)


def run_section(section: str, folder: Path, edges=None, seeds=None):
    data_dir = str(folder / "data")
    results_dir = str(folder / "results")
    exp_ids = SECTIONS[section]

    print(f"\n{'='*60}")
    print(f"SECTION: {section}  (experiments {exp_ids})")
    print(f"  Folder: {folder.name}")
    print(f"{'='*60}")

    if section == "all":
        print(f"\n{estimate_budget()}\n")

    for exp_id in exp_ids:
        run_experiment(exp_id, data_dir, results_dir,
                       edges=edges, seeds=seeds)

    print(f"\n{'='*60}")
    print(f"SECTION '{section}' COMPLETE")
    print(f"{'='*60}")

    if section == "all":
        print(f"\nNext: repro figures && repro verify")


def run_smoke(folder: Path):
    data_dir = str(folder / "data")
    results_dir = str(folder / "results")
    print("SMOKE TEST: running bring-up gate only (small corpus, small maps)")
    run_experiment(2, data_dir, results_dir)
    print("\nSmoke test passed. The toolchain works end-to-end.")


def main():
    parser = argparse.ArgumentParser(
        description="sparsesom-paper1 reproduction CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=("Sections:\n"
                "  gate     Corpus manifest + bringup gate + PCA equivalence\n"
                "  sweep    Master size sweep\n"
                "  bench    Capacity frontier\n"
                "  compare  Implementation comparison + efficiency sweep\n"
                "  all      Everything (gate + bench + sweep + compare)\n"),
    )
    parser.add_argument(
        "command", nargs="?", default="all",
        choices=["init", "all", "gate", "sweep", "bench", "compare",
                 "run", "figures", "verify"],
    )
    parser.add_argument("id", nargs="?", type=int, default=None,
                        help="Experiment ID (for 'run' command)")
    parser.add_argument("--run", default=None, metavar="FOLDER",
                        help="Experiment folder (e.g. SBS-200726-1430)")
    parser.add_argument("--edges", default=None,
                        help="Override edge ladder (comma-separated)")
    parser.add_argument("--seeds", default=None,
                        help="Override seed list (comma-separated)")
    parser.add_argument("--smoke", action="store_true",
                        help="Quick ~10-min smoke test")
    parser.add_argument("--profile", default=None,
                        choices=["full", "sections", "outline"],
                        help="Reproduction mode: full (all sims + seeds for the "
                             "paper's statistics, ~6.5 days), sections (the same set "
                             "run in named chunks — run all = full), outline "
                             "(~3h minimum set showing the patterns, no statistics)")

    args = parser.parse_args()

    edges = [int(e) for e in args.edges.split(",")] if args.edges else None
    seeds = [int(s) for s in args.seeds.split(",")] if args.seeds else None

    if args.smoke:
        folder = resolve_folder(args.run, create_if_missing=True)
        run_smoke(folder)
        return

    if args.profile:
        folder = resolve_folder(args.run, create_if_missing=True)
        if args.profile == "outline":
            from pipeline import profile_outline
            profile_outline.run(str(folder / "data"), str(folder / "results"))
        elif args.profile == "full":
            # full == the complete section sweep. NOTE: coverage is being
            # completed (see task: fold roofline/somoclu/medsom/equal-quality
            # standalone scripts in as sections, add ex09, so all == the paper).
            run_section("all", folder, edges=edges, seeds=seeds)
        else:  # sections
            print("Sectioned reproduction — run these in order; together they\n"
                  "equal `--profile full` (exhaustive, non-overlapping):\n"
                  "  repro gate      # corpus manifest + bringup + PCA equivalence\n"
                  "  repro sweep     # size sweep + sigma0xPCA (statistics)\n"
                  "  repro bench     # capacity frontier\n"
                  "  repro compare   # impl-compare + efficiency + roofline + somoclu\n"
                  "Each writes to the same experiment folder; `repro verify`\n"
                  "checks the accumulated results against configs/claims.yaml.")
        return

    if args.command == "init":
        do_init()
        return

    if args.command == "run":
        if args.id is None:
            print("ERROR: 'run' requires an experiment ID. "
                  "Usage: repro run 5")
            sys.exit(1)
        folder = resolve_folder(args.run)
        data_dir = str(folder / "data")
        results_dir = str(folder / "results")
        run_experiment(args.id, data_dir, results_dir,
                       edges=edges, seeds=seeds)
        return

    if args.command in SECTIONS:
        folder = resolve_folder(args.run, create_if_missing=True)
        run_section(args.command, folder, edges=edges, seeds=seeds)
        return

    if args.command == "figures":
        folder = resolve_folder(args.run, create_if_missing=False)
        from figures.generate_all import main as gen_figures
        gen_figures(str(folder / "results"), str(folder / "figures"))
        return

    if args.command == "verify":
        folder = resolve_folder(args.run, create_if_missing=False)
        from pipeline.verify_claims import main as verify_main
        sys.argv = ["verify", "--results-dir", str(folder / "results"),
                    "--claims", "configs/claims.yaml"]
        verify_main()
        return


if __name__ == "__main__":
    main()
